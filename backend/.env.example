# ─── Django ───────────────────────────────────────────────────────────────
# Generate a strong random value for production (do NOT reuse the dev default).
SECRET_KEY=your-secret-key-here-change-in-production
# DEBUG must be False in production.
DEBUG=True
# Comma-separated hosts, required when DEBUG=False (production settings).
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
DB_NAME=offboarding_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ─── CORS / URLs ────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API (no wildcards in production).
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Settings module: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# ─── Email / Notifications ──────────────────────────────────────────────────
# Dev default prints emails to the console. For production, set the SMTP backend
# and your company mail server credentials so every notification is delivered.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production example (uncomment & fill):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yourprovider.com      # e.g. smtp.gmail.com / smtp.office365.com / mail.jsanconsulting.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=offboarding@jsanconsulting.com
# EMAIL_HOST_PASSWORD=your-smtp-or-app-password
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=offboarding@jsanconsulting.com
# Master switch: mirror every in-app notification to email.
NOTIFICATION_EMAILS_ENABLED=True
